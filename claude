#include <NimBLEDevice.h>

// ---- Configuration ----
const char* TARGET_ADDRESS = "aa:bb:cc:dd:ee:ff"; // lowercase BLE address of the device to track
const int   RSSI_NEAR = -40;   // dBm at closest distance -> byte 255
const int   RSSI_FAR  = -90;   // dBm at farthest distance -> byte 0
const float SMOOTHING = 0.2;   // 0..1, lower = smoother but slower
const int   OUTPUT_PIN = 2;    // PWM pin (GPIO2 is the onboard LED on many ESP32 boards)

float smoothedRssi = 0;
bool  hasFirstReading = false;

// Converts RSSI to a byte: RSSI_NEAR -> 255, RSSI_FAR -> 0
uint8_t rssiToByte(float rssi) {
  // Clamp to the calibrated range
  if (rssi > RSSI_NEAR) {
    rssi = RSSI_NEAR;
  }
  if (rssi < RSSI_FAR) {
    rssi = RSSI_FAR;
  }

  // Normalize to 0.0 .. 1.0 (1.0 = closest)
  float fraction = (rssi - RSSI_FAR) / (float)(RSSI_NEAR - RSSI_FAR);

  // Scale to 0 .. 255
  return (uint8_t)(fraction * 255.0 + 0.5);
}

class ScanCallbacks : public NimBLEScanCallbacks {
  void onResult(const NimBLEAdvertisedDevice* device) override {
    // Only react to our target device
    if (device->getAddress().toString() != TARGET_ADDRESS) {
      return;
    }

    int rawRssi = device->getRSSI();

    // Exponential moving average, because raw RSSI is noisy
    if (!hasFirstReading) {
      smoothedRssi = rawRssi;
      hasFirstReading = true;
    } else {
      smoothedRssi = SMOOTHING * rawRssi + (1.0 - SMOOTHING) * smoothedRssi;
    }

    uint8_t value = rssiToByte(smoothedRssi);

    Serial.printf("raw=%d dBm  smoothed=%.1f dBm  byte=%u\n", rawRssi, smoothedRssi, value);

    // Use the byte here: PWM LED brightness (or send it over serial, etc.)
    analogWrite(OUTPUT_PIN, value);
  }
};

void setup() {
  Serial.begin(115200);
  pinMode(OUTPUT_PIN, OUTPUT);

  NimBLEDevice::init("");
  NimBLEScan* scan = NimBLEDevice::getScan();
  scan->setScanCallbacks(new ScanCallbacks(), true); // true = report duplicates (needed for continuous RSSI)
  scan->setActiveScan(false);
  scan->setInterval(100);
  scan->setWindow(100);
  scan->start(0, false); // 0 = scan forever
}

void loop() {
  // Nothing to do, scanning runs in the background
}
